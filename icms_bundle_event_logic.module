<?php

/**
 * @file
 * Contains hooks for icms_bundle_event_logic module.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\search_api\Query\ResultSetInterface;
use Drupal\webform\WebformInterface;
use Drupal\webform\WebformSubmissionInterface;

/**
 * Implements hook_ENTITY_TYPE_presave() for webform_submission entities.
 *
 * @see \Drupal\icms_bundle_event_logic\EventRegistrationManager::attachSourceEntity()
 */
function icms_bundle_event_logic_webform_submission_presave(WebformSubmissionInterface $submission): void {
  \Drupal::service('icms_bundle_event_logic.registration_manager')
    ->attachSourceEntity($submission);
}

/**
 * Implements hook_ENTITY_TYPE_presave() for webform entities.
 *
 * The access rules are granted on creation only. Re-granting them on every save
 * would need a second save from inside the insert hook, and would overrule an
 * administrator who removed a role on purpose.
 */
function icms_bundle_event_logic_webform_presave(EntityInterface $webform): void {
  if (!$webform instanceof WebformInterface || !$webform->isNew()) {
    return;
  }

  \Drupal::service('icms_bundle_event_logic.registration_manager')
    ->grantResultsAccess($webform);
}

/**
 * Implements hook_ENTITY_TYPE_insert() for webform entities.
 *
 * A duplicated registration form inherits none of the results table settings,
 * which live in state rather than config, so it is set up here.
 */
function icms_bundle_event_logic_webform_insert(EntityInterface $webform): void {
  if (!$webform instanceof WebformInterface) {
    return;
  }

  \Drupal::service('icms_bundle_event_logic.registration_manager')
    ->syncResultsTable($webform);
}

/**
 * Implements hook_ENTITY_TYPE_update() for webform entities.
 *
 * Recomputing the column list on every save is what lets an element added to
 * the form later show up in the results table on its own.
 */
function icms_bundle_event_logic_webform_update(EntityInterface $webform): void {
  if (!$webform instanceof WebformInterface) {
    return;
  }

  // Only the results table is touched here. The access rules are left alone:
  // re-granting them would need another save, and an administrator who removed
  // a role deliberately should keep that.
  \Drupal::service('icms_bundle_event_logic.registration_manager')
    ->syncResultsTable($webform);
}

/**
 * Implements hook_search_api_results_alter().
 *
 * Prevents de-duplication of expanded event items in GraphQL responses by
 * marking each entity with a unique identifier based on the search item delta.
 */
function icms_bundle_event_logic_search_api_results_alter(ResultSetInterface &$results) {
  $items = $results->getResultItems();

  foreach ($items as $item) {
    $item_id = $item->getId();

    // Check if this is an expanded item with a delta suffix.
    if (preg_match('/^(.+):(\d+)$/', $item_id, $matches)) {
      $delta = (int) $matches[2];

      try {
        $entity = $item->getOriginalObject()->getValue();

        // Add a temporary property to make this entity unique for GraphQL.
        // GraphQL uses object identity, so we can't just set a property.
        // Instead, store it in the item's extra data which GraphQL can access.
        $item->setExtraData('_event_date_delta', $delta);
        $item->setExtraData('_event_date_instance_id', $item_id);

        // Also set it on the entity as a temporary value.
        if ($entity && method_exists($entity, 'set')) {
          $entity->_event_date_delta = $delta;
          $entity->_search_api_item_id = $item_id;
        }
      }
      catch (\Exception $e) {
        \Drupal::logger('icms_bundle_event_logic')->error(
          'Error in search_api_results_alter for item @id: @message',
          ['@id' => $item_id, '@message' => $e->getMessage()]
        );
      }
    }
  }
}
