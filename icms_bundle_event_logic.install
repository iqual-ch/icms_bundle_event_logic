<?php

/**
 * @file
 * Update hooks for ICMS Event bundle.
 */

use Drupal\Core\StringTranslation\TranslatableMarkup;
use Symfony\Component\Yaml\Yaml;

/**
 * Implements hook_install().
 *
 * Sets the module weight to 50 to ensure deployment hooks run in the
 * correct order after core modules.
 */
function icms_bundle_event_logic_install() {
  module_set_weight('icms_bundle_event_logic', 50);

  // Import default bundle texts on module installation.
  icms_bundle_event_logic_import_default_texts();

  // Grant "view event registrations" permission to relevant roles.
  $roles_to_update = ['content_editor', 'administrator_client'];
  foreach ($roles_to_update as $role_id) {
    $role = \Drupal::entityTypeManager()->getStorage('user_role')->load($role_id);
    if ($role && !\Drupal::moduleHandler()->moduleExists('webform')) {
      \Drupal::logger('icms_bundle_event_logic')->warning(
        'Webform module not enabled, skipping permission grant for @role',
        ['@role' => $role_id]
      );
    }
    elseif ($role) {
      $role->grantPermission('view event registrations');
      $role->save();
    }
  }

  // The module's own admin strings; the ICMS packages get no .po from
  // localize.drupal.org.
  \Drupal::moduleHandler()->loadInclude('icms_admin', 'install');
  icms_admin_import_interface_translations('icms_bundle_event_logic');

  // Attempt to install webform during module installation.
  // Note: During site installation with --existing-config, this may be
  // overwritten by config import. The icms_admin.webform_install_subscriber
  // event subscriber will reinstall webforms after config import completes.
  icms_bundle_event_logic_install_webform('webform.webform.icms_event_registration', 'icms_bundle_event_logic');
}

/**
 * Imports default text entities from the package-local texts file.
 */
function icms_bundle_event_logic_import_default_texts(): void {
  $module_name = 'icms_bundle_event_logic';
  $module_handler = \Drupal::moduleHandler();

  if (!$module_handler->moduleExists('texts') || !$module_handler->moduleExists('texts_sync')) {
    \Drupal::logger($module_name)->notice('Skipped texts import during install because texts/texts_sync is not enabled.');
    return;
  }

  $module_path = \Drupal::service('extension.list.module')->getPath($module_name);
  $texts_file = DRUPAL_ROOT . '/' . $module_path . '/texts/texts.yml';

  if (!is_readable($texts_file)) {
    \Drupal::logger($module_name)->notice('Skipped texts import during install because no readable texts file was found at @path.', ['@path' => $texts_file]);
    return;
  }

  try {
    $data = Yaml::parseFile($texts_file);
    if (!is_array($data) || empty($data)) {
      \Drupal::logger($module_name)->warning('Skipped texts import during install because YAML was empty or invalid: @path', ['@path' => $texts_file]);
      return;
    }

    /** @var \Drupal\texts_sync\TextsSyncService $texts_sync */
    $texts_sync = \Drupal::service('texts_sync.service');
    $stats = $texts_sync->import($data, NULL, TRUE);

    \Drupal::logger($module_name)->notice('Imported default texts during install. Created: @created, Updated: @updated, Skipped: @skipped.', [
      '@created' => (int) ($stats['created'] ?? 0),
      '@updated' => (int) ($stats['updated'] ?? 0),
      '@skipped' => (int) ($stats['skipped'] ?? 0),
    ]);
  }
  catch (\Throwable $e) {
    \Drupal::logger($module_name)->error('Failed to import default texts during install: @message', ['@message' => $e->getMessage()]);
  }
}

/**
 * Add postprocess_query weight to smart_date_instance processor.
 */
function icms_bundle_event_logic_update_9001() {
  $config_factory = \Drupal::configFactory();
  $config = $config_factory->getEditable('search_api.index.content_search');

  // Check if the smart_date_instance processor exists.
  $processor_settings = $config->get('processor_settings.smart_date_instance');
  if ($processor_settings) {
    // Add the postprocess_query weight if not already set.
    $weights = $config->get('processor_settings.smart_date_instance.weights') ?: [];
    if (!isset($weights['postprocess_query'])) {
      $config->set('processor_settings.smart_date_instance.weights.postprocess_query', 0);
      $config->save(TRUE);
      return new TranslatableMarkup('Added postprocess_query weight to smart_date_instance processor.');
    }
  }

  return new TranslatableMarkup('smart_date_instance processor already configured correctly.');
}

/**
 * Rename the events_listing parent_id field to nid.
 */
function icms_bundle_event_logic_update_9002() {
  $index = \Drupal::entityTypeManager()->getStorage('search_api_index')->load('events_listing');
  if (!$index) {
    return new TranslatableMarkup('events_listing index not found, nothing to do.');
  }

  $fields = $index->getFields();
  if (isset($fields['nid']) || !isset($fields['parent_id'])) {
    return new TranslatableMarkup('events_listing index already exposes nid.');
  }

  // Listings exclude the node they are placed on through a nid condition;
  // for indexed occurrence paragraphs that is the parent node's ID. Renaming
  // through the index API keeps the indexed data and updates processor
  // field lists.
  $index->renameField('parent_id', 'nid');
  $index->getField('nid')->setLabel('Parent node ID');
  $index->save();

  return new TranslatableMarkup('Renamed the events_listing parent_id field to nid.');
}

/**
 * Helper function to install a webform from a YAML config file.
 *
 * This shared utility can be used by any module that needs to install webforms
 * programmatically from config files, keeping the code DRY.
 *
 * @param string $config_name
 *   The config name (e.g., 'webform.webform.contact').
 * @param string $module_name
 *   The module name where the config file is located.
 *
 * @return bool
 *   TRUE if successful, FALSE otherwise.
 */
function icms_bundle_event_logic_install_webform($config_name, $module_name) {
  // Check if webform module is installed.
  if (!\Drupal::moduleHandler()->moduleExists('webform')) {
    \Drupal::logger($module_name)->warning(
      'Webform module not installed yet, skipping webform installation for @config',
      ['@config' => $config_name]
    );
    return FALSE;
  }

  try {
    // Extract webform ID from config name.
    $webform_id = str_replace('webform.webform.', '', $config_name);

    // Check if webform already exists.
    $webform_storage = \Drupal::entityTypeManager()->getStorage('webform');
    $existing_webform = $webform_storage->load($webform_id);

    if ($existing_webform) {
      \Drupal::logger($module_name)->info(
        'Webform @id already exists, skipping installation.',
        ['@id' => $webform_id]
      );
      return TRUE;
    }

    // Load the YAML file from the module's config directory.
    $module_path = \Drupal::service('extension.list.module')->getPath($module_name);
    $config_file = $module_path . '/config/install/' . $config_name . '.yml';

    if (!file_exists($config_file)) {
      \Drupal::logger($module_name)->error(
        'Webform config file not found: @file',
        ['@file' => $config_file]
      );
      return FALSE;
    }

    // Parse the YAML file.
    $config_data = Yaml::parseFile($config_file);

    if (empty($config_data)) {
      \Drupal::logger($module_name)->error(
        'Failed to parse webform config file: @file',
        ['@file' => $config_file]
      );
      return FALSE;
    }

    // Remove UUID and other deployment-specific keys.
    unset($config_data['uuid']);
    unset($config_data['_core']);

    // Create the webform entity.
    $webform = $webform_storage->create($config_data);
    $webform->save();

    \Drupal::logger($module_name)->info(
      'Successfully installed webform: @id',
      ['@id' => $webform_id]
    );

    return TRUE;
  }
  catch (\Exception $e) {
    \Drupal::logger($module_name)->error(
      'Error installing webform @config: @message',
      [
        '@config' => $config_name,
        '@message' => $e->getMessage(),
      ]
    );
    return FALSE;
  }
}

/**
 * Filter event registrations on the raw webform ID instead of the bundle.
 */
function icms_bundle_event_logic_update_9003() {
  $storage = \Drupal::entityTypeManager()->getStorage('view');
  $view = $storage->load('event_registrations');

  if (!$view) {
    return new TranslatableMarkup('The event_registrations view does not exist, nothing to update.');
  }

  $display = $view->get('display');
  $filters = $display['default']['display_options']['filters'] ?? [];

  if (!isset($filters['webform_id']) || ($filters['webform_id']['plugin_id'] ?? '') !== 'bundle') {
    return new TranslatableMarkup('The event_registrations view already filters on the raw webform ID.');
  }

  // Keep whatever webform the site actually filters on — a client may have
  // pointed the view at a webform of their own.
  $webform_ids = array_keys((array) ($filters['webform_id']['value'] ?? []));
  $webform_id = reset($webform_ids) ?: 'icms_event_registration';

  // Replace the filter in place so its position in the list is preserved.
  $replaced = [];
  foreach ($filters as $key => $filter) {
    if ($key === 'webform_id') {
      $replaced['icms_webform_id'] = [
        'id' => 'icms_webform_id',
        'table' => 'webform_submission',
        'field' => 'icms_webform_id',
        'plugin_id' => 'string',
        'operator' => '=',
        'value' => $webform_id,
      ];
      continue;
    }
    $replaced[$key] = $filter;
  }

  $display['default']['display_options']['filters'] = $replaced;
  $view->set('display', $display);

  // The replacement filter is provided by this module's hook_views_data_alter()
  // and has to be known before the view is saved, or its handler is broken.
  \Drupal::service('views.views_data')->clear();
  $view->save();

  return new TranslatableMarkup('Replaced the bundle filter on the event_registrations view with a raw webform ID filter, dropping the config dependency on webform.webform.@id.', [
    '@id' => $webform_id,
  ]);
}

/**
 * Install webform_node, which now serves the registrations listing.
 */
function icms_bundle_event_logic_update_9004() {
  if (\Drupal::moduleHandler()->moduleExists('webform_node')) {
    return new TranslatableMarkup('webform_node is already installed.');
  }

  \Drupal::service('module_installer')->install(['webform_node']);

  return new TranslatableMarkup('Installed webform_node.');
}

/**
 * Retire the event_registrations view and the webform_views dependency.
 *
 * The view listed registrations with one Views field per element of the shipped
 * registration form, which froze it to that one form. Webform's own results
 * pages build their table from the form's elements at request time.
 */
function icms_bundle_event_logic_update_9005() {
  $messages = [];

  $config = \Drupal::configFactory()->getEditable('views.view.event_registrations');
  if (!$config->isNew()) {
    $config->delete();
    $messages[] = 'Deleted the event_registrations view.';
  }

  if (!\Drupal::moduleHandler()->moduleExists('webform_views')) {
    $messages[] = 'webform_views is not installed.';
    return implode(' ', $messages);
  }

  // Uninstalling a module deletes the config that depends on it, so a client
  // who built their own webform views keeps the module instead.
  $dependents = \Drupal::service('config.manager')
    ->findConfigEntityDependencies('module', ['webform_views']);

  if ($dependents) {
    $messages[] = sprintf(
      'Kept webform_views: %d config object(s) still depend on it (%s).',
      count($dependents),
      implode(', ', array_keys($dependents))
    );
  }
  else {
    \Drupal::service('module_installer')->uninstall(['webform_views']);
    $messages[] = 'Uninstalled webform_views.';
  }

  return implode(' ', $messages);
}

/**
 * Point existing registrations at their event node.
 *
 * Submissions made before the presave hook landed are stored against the
 * GraphQL server, so Drupal reports no registrations per event. Their event is
 * recoverable from the hidden node_id element.
 *
 * @see \Drupal\icms_bundle_event_logic\EventRegistrationManager::attachSourceEntity()
 */
function icms_bundle_event_logic_update_9006(array &$sandbox) {
  $storage = \Drupal::entityTypeManager()->getStorage('webform_submission');
  /** @var \Drupal\icms_bundle_event_logic\EventRegistrationManager $manager */
  $manager = \Drupal::service('icms_bundle_event_logic.registration_manager');

  if (!isset($sandbox['ids'])) {
    // Only submissions that are not already attached to a node need looking at.
    // A submission without any source entity has a NULL entity_type, which a
    // plain "<>" comparison would leave out.
    $query = $storage->getQuery()->accessCheck(FALSE);
    $query->condition($query->orConditionGroup()
      ->condition('entity_type', 'node', '<>')
      ->notExists('entity_type'));
    $sandbox['ids'] = array_values($query->execute());
    $sandbox['total'] = count($sandbox['ids']);
    $sandbox['updated'] = 0;
  }

  foreach (array_splice($sandbox['ids'], 0, 50) as $id) {
    $submission = $storage->load($id);
    if ($submission === NULL) {
      continue;
    }

    if ($manager->attachSourceEntity($submission)) {
      // resave() keeps the submission's own timestamps and serial intact.
      $submission->resave();
      $sandbox['updated']++;
    }
  }

  $sandbox['#finished'] = $sandbox['ids'] ? 0 : 1;

  if ($sandbox['ids']) {
    return new TranslatableMarkup('@count submissions left to check.', [
      '@count' => count($sandbox['ids']),
    ]);
  }

  return new TranslatableMarkup('Checked @total submissions, attached @updated to their event.', [
    '@total' => $sandbox['total'],
    '@updated' => $sandbox['updated'],
  ]);
}

/**
 * Let the event editing roles read registrations through Webform.
 *
 * Registrations used to be reachable only through the event_registrations view,
 * which is guarded by "view event registrations". Webform's own results pages
 * check the webform's access rules instead, and the event editing roles hold
 * none of the global webform permissions.
 *
 * @see \Drupal\icms_bundle_event_logic\EventRegistrationManager::grantResultsAccess()
 */
function icms_bundle_event_logic_update_9007() {
  /** @var \Drupal\icms_bundle_event_logic\EventRegistrationManager $manager */
  $manager = \Drupal::service('icms_bundle_event_logic.registration_manager');

  $updated = [];
  foreach (\Drupal::entityTypeManager()->getStorage('webform')->loadMultiple() as $webform) {
    if ($manager->grantResultsAccess($webform)) {
      $webform->save();
      $updated[] = $webform->id();
    }
  }

  if (!$updated) {
    return new TranslatableMarkup('No registration forms needed an access rule change.');
  }

  return new TranslatableMarkup('Granted view_any on: @forms.', [
    '@forms' => implode(', ', $updated),
  ]);
}

/**
 * Apply the registration results table to the forms that already exist.
 *
 * New and duplicated forms get it from hook_webform_insert(); this covers the
 * ones created before that hook landed.
 *
 * @see \Drupal\icms_bundle_event_logic\EventRegistrationManager::syncResultsTable()
 */
function icms_bundle_event_logic_update_9008() {
  /** @var \Drupal\icms_bundle_event_logic\EventRegistrationManager $manager */
  $manager = \Drupal::service('icms_bundle_event_logic.registration_manager');

  $applied = [];
  foreach (\Drupal::entityTypeManager()->getStorage('webform')->loadMultiple() as $webform) {
    if ($manager->syncResultsTable($webform)) {
      $applied[] = $webform->id();
    }
  }

  if (!$applied) {
    return new TranslatableMarkup('No registration forms needed a results table.');
  }

  return new TranslatableMarkup('Results table applied to: @forms.', [
    '@forms' => implode(', ', $applied),
  ]);
}

/**
 * Import the German, French and Italian strings for the registrations screen.
 *
 * @see icms_admin_import_interface_translations()
 */
function icms_bundle_event_logic_update_9009() {
  \Drupal::moduleHandler()->loadInclude('icms_admin', 'install');
  $summary = icms_admin_import_interface_translations('icms_bundle_event_logic');

  if (!$summary) {
    return new TranslatableMarkup('No interface translations needed importing.');
  }

  return new TranslatableMarkup('Imported interface translations (@summary).', [
    '@summary' => implode(', ', $summary),
  ]);
}

/**
 * Add the ICMS event date formats and the smart date GraphQL extension.
 */
function icms_bundle_event_logic_update_9010() {
  $messages = [];

  // Create the dedicated event date formats shipped with the bundle recipe.
  // The copies in config/update/9002 are identical to the recipe's.
  $module_path = \Drupal::service('extension.list.module')->getPath('icms_bundle_event_logic');
  $storage = \Drupal::entityTypeManager()->getStorage('date_format');
  foreach (['icms_event_date', 'icms_event_time'] as $format_id) {
    if ($storage->load($format_id)) {
      $messages[] = "Date format $format_id already exists.";
      continue;
    }
    $file = DRUPAL_ROOT . '/' . $module_path . '/config/update/9002/core.date_format.' . $format_id . '.yml';
    if (!is_readable($file)) {
      \Drupal::logger('icms_bundle_event_logic')->error('Date format config file not found: @file', ['@file' => $file]);
      continue;
    }
    $data = Yaml::parseFile($file);
    $storage->createFromStorageRecord($data)->save();
    $messages[] = "Created date format $format_id.";
  }

  // Apply the config translations the recipe ships for fresh installs.
  $language_manager = \Drupal::languageManager();
  $installed = $language_manager->getLanguages();
  foreach (['de', 'fr', 'it'] as $langcode) {
    if (!isset($installed[$langcode])) {
      continue;
    }
    foreach (['icms_event_date', 'icms_event_time'] as $format_id) {
      $file = DRUPAL_ROOT . '/' . $module_path . '/config/update/9002/language/' . $langcode . '/core.date_format.' . $format_id . '.yml';
      if (!is_readable($file)) {
        continue;
      }
      $override = $language_manager->getLanguageConfigOverride($langcode, 'core.date_format.' . $format_id);
      if ($override->isNew()) {
        $override->setData(Yaml::parseFile($file));
        $override->save();
      }
    }
  }

  // Enable the icms_event_dates schema extension (formatted smart date end
  // values) on the GraphQL server, as the recipe does for new installs.
  $config = \Drupal::configFactory()->getEditable('graphql.graphql_servers.graphql');
  if ($config->get('schema') !== NULL) {
    $extensions = $config->get('schema_configuration.core_composable.extensions') ?: [];
    if (!isset($extensions['icms_event_dates'])) {
      $config->set('schema_configuration.core_composable.extensions.icms_event_dates', 'icms_event_dates');
      $config->save(TRUE);
      $messages[] = 'Enabled the icms_event_dates GraphQL schema extension.';
    }
    else {
      $messages[] = 'The icms_event_dates GraphQL schema extension was already enabled.';
    }
  }

  return implode(' ', $messages);
}

/**
 * Add the event calendar settings and their GraphQL exposure.
 */
function icms_bundle_event_logic_update_9011() {
  $messages = [];

  // Import the default calendar settings shipped in config/install.
  $config = \Drupal::configFactory()->getEditable('icms_bundle_event_logic.calendar_settings');
  if ($config->isNew()) {
    $module_path = \Drupal::service('extension.list.module')->getPath('icms_bundle_event_logic');
    $file = DRUPAL_ROOT . '/' . $module_path . '/config/install/icms_bundle_event_logic.calendar_settings.yml';
    if (is_readable($file)) {
      $config->setData(Yaml::parseFile($file))->save(TRUE);
      $messages[] = 'Imported the default calendar settings.';
    }
  }
  else {
    $messages[] = 'Calendar settings already present.';
  }

  // Enable the icms_event_calendar schema extension, as the recipe does for
  // new installs.
  $server = \Drupal::configFactory()->getEditable('graphql.graphql_servers.graphql');
  if ($server->get('schema') !== NULL && !$server->get('schema_configuration.core_composable.extensions.icms_event_calendar')) {
    $server->set('schema_configuration.core_composable.extensions.icms_event_calendar', 'icms_event_calendar');
    $server->save(TRUE);
    $messages[] = 'Enabled the icms_event_calendar GraphQL schema extension.';
  }

  return implode(' ', $messages);
}

/**
 * Re-import the bundle texts: adds the event calendar strings.
 */
function icms_bundle_event_logic_update_9012() {
  icms_bundle_event_logic_import_default_texts();
  return 'Re-imported the event bundle texts.';
}

/**
 * Events listing: stop partitioning the index by language.
 *
 * Occurrence paragraphs are not translatable, so each occurrence exists in
 * exactly one language — but the GraphQL search filtered items by the request
 * language whenever the index carried a language field. An event created in
 * German therefore never appeared on the French site. Removing the langcode
 * field makes every occurrence visible in every language; parent nodes still
 * resolve in the request language.
 */
function icms_bundle_event_logic_update_9013() {
  /** @var \Drupal\search_api\IndexInterface|null $index */
  $index = \Drupal::entityTypeManager()->getStorage('search_api_index')->load('events_listing');
  if (!$index) {
    return 'No events_listing index on this site.';
  }

  if ($index->getField('langcode')) {
    $index->removeField('langcode');
  }

  // Drop the field from the processors that reference it.
  foreach (['tokenizer', 'ignorecase'] as $processor_id) {
    $settings = $index->getProcessors()[$processor_id] ?? NULL;
    if ($settings) {
      $configuration = $settings->getConfiguration();
      if (!empty($configuration['fields'])) {
        $configuration['fields'] = array_values(array_diff($configuration['fields'], ['langcode']));
        $settings->setConfiguration($configuration);
      }
    }
  }

  $index->save();
  $index->reindex();

  return 'Removed the language partition from the events_listing index and queued a reindex.';
}

/**
 * Let editors choose the original language of events.
 *
 * Mirrors the recipe: the language selector is enabled for the content type
 * and placed above the form tabs. The shared helper lives in icms_core_logic,
 * which every ICMS site has installed.
 */
function icms_bundle_event_logic_update_9014() {
  \Drupal::moduleHandler()->loadInclude('icms_core_logic', 'install');
  if (!function_exists('_icms_core_logic_enable_original_language_selection')) {
    return (string) new TranslatableMarkup('Skipped: icms_core_logic is missing the language selection helper, update it first.');
  }

  $messages = _icms_core_logic_enable_original_language_selection('node', 'icms_event');
  if (!$messages) {
    return (string) new TranslatableMarkup('The original language of events was already selectable.');
  }
  return implode(' ', $messages);
}
